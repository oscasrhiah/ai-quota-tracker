{
  "name": "ai-quota-tracker",
  "version": "2.2.1",
  "private": true,
  "description": "AI 訂閱額度追蹤器：即時查看各家 AI 工具用量與重置倒數，關閉視窗自動縮到系統托盤",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "make-icon": "node tools/make-icon.cjs"
  },
  "dependencies": {
    "react": "*",
    "react-dom": "*",
    "undici": "*"
  },
  "devDependencies": {
    "@types/node": "*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "*",
    "electron-builder": "*",
    "electron-vite": "^2.3.0",
    "typescript": "*",
    "vite": "^5.4.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "electron-winstaller@5.4.0": true
  }
}
